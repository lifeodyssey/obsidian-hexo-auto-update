{
  "name": "hexo-auto-updater",
  "version": "2.0.1",
  "description": "Desktop Obsidian plugin for safe, scoped synchronization with a local Hexo Git repository.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest && node --test scripts/release.test.mjs",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "jest --testPathPatterns=tests/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "check": "npm run lint && npm run typecheck && npm run test",
    "health:check": "npm run typecheck && npm run test:unit && npm run test:integration",
    "security:audit": "npm audit"
  },
  "keywords": [],
  "author": "Zhenjia Zhou",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/electron": "^1.4.38",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "builtin-modules": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.0.4",
    "obsidian": "1.14.4",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "@types/picomatch": "^4.0.3"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "simple-git": "4.0.2",
    "picomatch": "^4.0.7"
  },
  "overrides": {
    "glob@>=9": "^14.0.4",
    "minimatch@>=7": "^11.0.5"
  }
}
